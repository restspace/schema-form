{
  "name": "@restspace/schema-form",
  "version": "2.0.0",
  "description": "JSON Schema based form generator in React",
  "author": "James Ellis-Jones",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/restspace/schema-form.git"
  },
  "keywords": [
    "react",
    "form generator",
    "form builder",
    "json schema"
  ],
  "main": "build/index.js",
  "type": "module",
  "types": "build/index.d.ts",
  "module": "build/index.es.js",
  "jsnext:main": "build/index.es.js",
  "sideEffects": [
    "**/*.scss",
    "**/*.css"
  ],
  "files": [
    "build",
    "src/css"
  ],
  "scripts": {
    "test": "jest",
    "build": "rollup -c 2> rollup-output.txt",
    "build-plain": "rollup -c",
    "sass": "sass src/scss:src/css"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "moduleDirectories": ["node_modules", "src"],
    "roots": ["<rootDir>/src"],
    "testPathIgnorePatterns": ["/node_modules/", "/build/"],
    "transformIgnorePatterns": ["/node_modules/(?!lodash-es)"],
    "setupFilesAfterEnv": ["<rootDir>/src/setupTests.ts"],
    "moduleNameMapper": {
      "\\.(svg|png|jpg|jpeg|gif|css|scss|sass)$": "<rootDir>/src/test/fileMock.cjs"
    }
  },
  "bugs": {
    "url": "https://github.com/restspace/schema-form/issues"
  },
  "homepage": "https://github.com/restspace/schema-form#readme",
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@rollup/plugin-commonjs": "^24.0.1",
    "@rollup/plugin-json": "^6.0.0",
    "@rollup/plugin-node-resolve": "^15.0.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.1.0",
    "@types/jest": "^29.5.12",
    "@types/jsonpointer": "^4.0.0",
    "@types/lodash": "^4.14.138",
    "@types/lodash-es": "^4.17.7",
    "@types/node": "^18.15.11",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rollup": "^3",
    "rollup-plugin-analyzer": "^4.0.0",
    "rollup-plugin-esbuild": "^5.0.0",
    "rollup-plugin-img": "^1.1.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-sass": "^1.12.19",
    "rollup-plugin-typescript2": "^0.34.1",
    "sass": "^1.29.0",
    "tslib": "^2.5.0",
    "typescript": "~5.3.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@exodus/schemasafe": "^1.0.0-rc.7",
    "dayjs": "^1.9.7",
    "jsonpointer": "^4.0.1",
    "lodash-es": "^4.17.21",
    "react-dropzone-esm": "^15.0.1"
  }
}
